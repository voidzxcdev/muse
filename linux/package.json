{
  "name": "muse",
  "productName": "Muse",
  "version": "1.0.4",
  "description": "Muse for Linux",
  "homepage": "https://getmuse.eu",
  "author": {
    "name": "voidzxcdev",
    "email": "dev@getmuse.eu"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux AppImage deb"
  },
  "dependencies": {
    "mpris-service": "2.1.2",
    "dbus-next": "0.10.2",
    "call-bind": "1.0.8",
    "call-bind-apply-helpers": "1.0.2"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "eu.getmuse.muse",
    "productName": "Muse",
    "asar": true,
    "asarUnpack": [
      "node_modules/**/*"
    ],
    "files": [
      "package.json",
      "main.js",
      "preload.js",
      "mpris.js",
      "updater.js",
      "build/icon.png",
      "node_modules/**/*"
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "AudioVideo",
      "maintainer": "voidzxcdev <dev@getmuse.eu>",
      "icon": "build/icon.png",
      "synopsis": "Muse",
      "executableName": "muse",
      "desktop": {
        "Name": "Muse",
        "Comment": "Search a song. Press play.",
        "StartupWMClass": "muse",
        "Categories": "AudioVideo;Audio;Player;Music;"
      }
    }
  }
}
