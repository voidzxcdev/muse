{
  "name": "muse",
  "productName": "Muse",
  "version": "1.0.0",
  "description": "Muse for Linux",
  "homepage": "https://getmuse.eu",
  "author": {
    "name": "voidzxcdev",
    "email": "dev@getmuse.eu"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux AppImage deb"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "eu.getmuse.muse",
    "productName": "Muse",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "build/icon.png"
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Audio",
      "maintainer": "voidzxcdev <dev@getmuse.eu>",
      "icon": "build/icon.png",
      "synopsis": "Muse",
      "executableName": "muse",
      "desktop": {
        "Name": "Muse",
        "Comment": "Search songs, build playlists, get mixes that learn your ears.",
        "StartupWMClass": "muse",
        "Categories": "Audio;Music;"
      }
    }
  }
}
